{
  "name": "maibot",
  "version": "0.0.1",
  "description": "MaiBot - LLM 智能体 · 长期记忆（Windows）",
  "scripts": {
    "setup": "python -m venv .venv && .venv\\Scripts\\python.exe -m pip install --disable-pip-version-check -r requirements.txt",
    "dev": "set ENV_FILE=.env.development && .venv\\Scripts\\python.exe -m app.main",
    "prod": "set ENV_FILE=.env.production && .venv\\Scripts\\python.exe -m app.main",
    "build": ".venv\\Scripts\\python.exe -m pip --disable-pip-version-check wheel -w dist -r requirements.txt",
    "build:exe": ".venv\\Scripts\\pyinstaller --noconsole --onefile --name mai-bot-x86_64-pc-windows-msvc --paths . --add-data \"prompts;prompts\" --add-data \".env.production;.\" --hidden-import=sqlmodel --hidden-import=pydantic_settings --hidden-import=chromadb --hidden-import=openai run.py",
    "lint": ".venv\\Scripts\\python.exe -m ruff check app",
    "format": ".venv\\Scripts\\python.exe -m ruff format --check app",
    "format:write": ".venv\\Scripts\\python.exe -m ruff format app",
    "clean": "rmdir /s /q .venv 2>nul & rmdir /s /q dist 2>nul & echo cleaned"
  },
  "engines": {
    "node": ">=14"
  }
}
