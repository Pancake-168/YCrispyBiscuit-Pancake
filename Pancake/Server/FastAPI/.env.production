APP_ENV=production
HOST=0.0.0.0
PORT=3000
DEBUG=false
JWT_SECRET_KEY=Pancake
DATABASE_AUTO_CREATE=true
# SQLite for production (embedded, zero-dependency)
# 打包后 WRITABLE_DIR 即 data/ 目录，db 直接放下面即可
DATABASE_URL=sqlite+aiosqlite:///./pancake.db
DSH_PROXY_PORT=3081
DSH_UPSTREAM_URL=http://127.0.0.1:3080
